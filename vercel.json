{
  "cleanUrls": true,
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "geolocation=(self), screen-wake-lock=(self)" }] }
  ]
}
